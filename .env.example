# PostgreSQL
DATABASE_URL=postgresql://username:password@host:5432/database_name

# JWT Authentication
JWT_SECRET_KEY=replace_with_a_long_random_secret

# GPS
GPS_SIMULATOR_ENABLED=false

# Superset (optional)
SUPERSET_URL=
SUPERSET_USERNAME=
SUPERSET_PASSWORD=
SUPERSET_EMBEDDED_DASHBOARD_ID=

# Production frontend URLs (comma-separated)
FRONTEND_ORIGINS=https://your-frontend-domain.example
