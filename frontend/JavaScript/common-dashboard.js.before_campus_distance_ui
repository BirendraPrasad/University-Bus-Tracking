/*
 * Generic fallback helper.
 */

async function withFallback(request, fallbackValue) {

  try {

    const data = await request();

    return {
      data,
      demo: false
    };

  } catch (error) {

    console.warn(
      "API request failed:",
      error.message
    );

    return {
      data: fallbackValue,
      demo: true
    };
  }
}


