/* ---------- Search ---------- */

function buildSearchIndex() {

  const items = [];


  state.routes.forEach(
    (route) => {

      if (route.bus_number) {

        items.push({
          kind: "Bus",
          label:
            route.bus_number,
          sub:
            route.name,
          page:
            "bus"
        });
      }


      items.push({

        kind: "Route",

        label:
          `${route.code} · ${route.name}`,

        sub:
          route.direction,

        page:
          "routes",

        filter:
          route.code
      });


      (
        route.stops || []
      ).forEach(
        (stop) => {

          items.push({

            kind: "Stop",

            label:
              typeof stop === "string"
                ? stop
                : stop.stop_name,

            sub:
              route.name,

            page:
              "routes",

            filter:
              typeof stop === "string"
                ? stop
                : stop.stop_name
          });
        }
      );

    }
  );


  state.searchIndex =
    items;
}


function runSearch(
  query
) {

  const box =
    $("searchResults");


  const q =
    query
      .trim()
      .toLowerCase();


  if (!q) {

    box.hidden = true;

    return;
  }


  const hits =
    state.searchIndex
      .filter(
        (item) =>
          `${item.label} ${item.sub}`
            .toLowerCase()
            .includes(q)
      )
      .slice(0, 8);


  box.innerHTML =

    hits.length

      ? hits
          .map(
            (hit, index) => `
              <button
                class="search-result"
                type="button"
                data-hit="${index}"
              >

                <em>
                  ${esc(hit.kind)}
                </em>

                <span>
                  ${esc(hit.label)}
                </span>

                <small>
                  ${esc(hit.sub)}
                </small>

              </button>
            `
          )
          .join("")

      : `
          <div class="search-empty">
            No matching bus, route or stop.
          </div>
        `;


  box._hits =
    hits;

  box.hidden =
    false;
}


function chooseHit(
  hit
) {

  if (!hit) {
    return;
  }


  if (hit.filter) {

    $("routesFilter").value =
      hit.filter;

    renderRoutesPage(
      hit.filter
    );
  }


  showSection(
    hit.page
  );


  $("searchResults").hidden =
    true;

  $("dashboardSearch").value =
    "";
}


