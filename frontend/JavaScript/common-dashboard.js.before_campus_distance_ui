          renderRouteStopsOnMap(selectedRoute);
          renderBusDetails();
          showSection("bus");
          startLivePolling();
        }
        return;
      }

      const opener =
        event.target.closest(
          "[data-open-page]"
        );


      if (opener) {

        if (opener.classList.contains("route-track-btn")) {
          const selectedRoute = state.routes.find(
            route => String(route.id) === String(opener.dataset.routeId)
          );

          if (selectedRoute) {
            state.activeRoute = selectedRoute;
            updateBusInfo({
              bus_number: selectedRoute.bus_number,
              route_code: selectedRoute.code,
              status: selectedRoute.status,
              current_stop: selectedRoute.current_stop,
              next_stop: selectedRoute.next_stop,
              eta_minutes: selectedRoute.eta_minutes
            });
            renderRouteStopsOnMap(selectedRoute);
            startLivePolling();
          }
        }

        showSection(
          opener.dataset.openPage
        );
      }


      if (
        !event.target.closest(
          ".search-box"
        )
      ) {

        $("searchResults").hidden =
          true;
      }

    }
  );


  $("fullMapBtn")
    ?.addEventListener(
      "click",
      () =>
        showSection("tracking")
    );


  $("trackBusBtn")
    ?.addEventListener(
      "click",
      () =>
        showSection("tracking")
    );


  $("notificationBtn")
    ?.addEventListener(
      "click",
      () =>
        showSection("notifications")
    );


  $("logoutBtn")
    ?.addEventListener(
      "click",
      logout
    );


  $("mobileMenuBtn")
    ?.addEventListener(
      "click",
      () => {

        if (
          $("sidebar")
            .classList
            .contains("open")
        ) {

          closeDrawer();

        } else {

          openDrawer();
        }
      }
    );


  $("sidebarOverlay")
    ?.addEventListener(
      "click",
      closeDrawer
    );


  window.addEventListener(
    "resize",
    () => {

      if (
        window.innerWidth > 900
      ) {

        closeDrawer();
      }

      refreshMaps();
    }
  );


  const search =
    $("dashboardSearch");


  if (search) {

    search.addEventListener(
      "input",
      () =>
        runSearch(
          search.value
        )
    );


    search.addEventListener(
      "keydown",
      (event) => {

        if (
          event.key === "Enter"
        ) {

          chooseHit(
            (
              $("searchResults")
                ._hits || []
            )[0]
          );
        }


        if (
          event.key === "Escape"
        ) {

          $("searchResults").hidden =
            true;

          search.blur();
        }

      }
    );
  }


  $("searchResults")
    ?.addEventListener(
      "click",
      (event) => {

        const button =
          event.target.closest(
            "[data-hit]"
          );


        if (!button) {
          return;
        }


        chooseHit(
          $("searchResults")
            ._hits[
              Number(
                button.dataset.hit
              )
            ]
        );
      }
    );


  document.addEventListener(
    "keydown",
    (event) => {

      if (
        event.key === "/" &&
        !/^(INPUT|TEXTAREA)$/.test(
          document.activeElement.tagName
        )
      ) {

        event.preventDefault();

        search?.focus();
      }


      if (
        event.key === "Escape"
      ) {

        closeDrawer();
      }

    }
  );


  $("routesFilter")
    ?.addEventListener(
      "input",
      (event) =>
        renderRoutesPage(
          event.target.value
        )
    );
}


