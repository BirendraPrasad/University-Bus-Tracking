/* ---------- Route stop markers ---------- */

function renderRouteStopsOnMap(
  route
) {

  if (
    !route ||
    !route.stopsData ||
    !route.stopsData.length
  ) {
    return;
  }

  // Ignore stops without GPS coordinates (0,0 placeholders).
  const validStops = route.stopsData.filter(
    (stop) =>
      Number.isFinite(stop.latitude) &&
      Number.isFinite(stop.longitude) &&
      stop.latitude >= -90 &&
      stop.latitude <= 90 &&
      stop.longitude >= -180 &&
      stop.longitude <= 180 &&
      !(stop.latitude === 0 && stop.longitude === 0)
  );

  const coordinates = validStops.map(
    (stop) => [
      stop.latitude,
      stop.longitude
    ]
  );

  if (!coordinates.length) {
    return;
  }


  Object.entries(
    state.maps
  ).forEach(
    ([key, map]) => {

      /*
       * Remove old stop markers.
       */

      if (state.stopMarkers[key]) {

        state.stopMarkers[key].forEach(
          (marker) => map.removeLayer(marker)
        );
      }

      state.stopMarkers[key] = [];


      /*
       * Remove old route line.
       */

      if (state.routeLines[key]) {

        map.removeLayer(
          state.routeLines[key]
        );
      }


      /*
       * Create stop markers.
       */

      validStops.forEach(
        (stop) => {

          const marker =
            L.marker([
              stop.latitude,
              stop.longitude
            ])
            .addTo(map)
            .bindPopup(
              `<strong>${esc(stop.stop_name)}</strong><br>
               Stop ${esc(stop.stop_order)}`
            );

          state.stopMarkers[key].push(
            marker
          );
        }
      );


      /*
       * Add Devanahalli common reference marker.
       * This marker is separate from actual bus stops and route line.
       */

      const devanahalliIcon = L.divIcon({
        className: "devanahalli-marker-icon",
        html: `
          <div style="
            width: 34px;
            height: 34px;
            background: linear-gradient(135deg, #38bdf8, #2563eb);
            border: 3px solid #ffffff;
            border-radius: 50% 50% 50% 0;
            transform: rotate(-45deg);
            box-shadow: 0 3px 12px rgba(37, 99, 235, 0.55);
            display: flex;
            align-items: center;
            justify-content: center;
          ">
            <div style="
              width: 10px;
              height: 10px;
              background: #ffffff;
              border-radius: 50%;
            "></div>
          </div>
        `,
        iconSize: [40, 40],
        iconAnchor: [17, 38],
        popupAnchor: [0, -38]
      });

      const devanahalliMarker = L.marker(
        [13.244561, 77.713652],
        { icon: devanahalliIcon, title: "Devanahalli" }
      )
        .addTo(map)
        .bindPopup(`
          <div style="min-width: 180px;">
            <strong style="font-size: 15px; color: #2563eb;">
              Devanahalli
            </strong>
            <div style="margin-top: 5px;">
              Common Reference Point
            </div>
            <small style="color: #64748b;">
              13.244561, 77.713652
            </small>
          </div>
        `);

      state.stopMarkers[key].push(devanahalliMarker);


      /*
       * Draw route line.
       */

      state.routeLines[key] =
        L.polyline(
          coordinates,
          {
            weight: 5,
            opacity: 0.8
          }
        ).addTo(map);


      /*
       * Fit map to route.
       */

      if (coordinates.length > 1) {

        map.fitBounds(
          L.latLngBounds(
            coordinates.concat([
              [13.244561, 77.713652]
            ])
          ),
          {
            padding: [
              30,
              30
            ]
          }
        );

      } else {

        map.setView(
          coordinates[0],
          16
        );
      }

    }
  );
}


