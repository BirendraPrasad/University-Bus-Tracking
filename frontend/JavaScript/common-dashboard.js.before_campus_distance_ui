const fmtEta = (minutes) => {

  if (
    minutes === null ||
    minutes === undefined ||
    Number.isNaN(Number(minutes))
  ) {
    return "—";
  }

  const value = Number(minutes);

  if (value >= 60) {

    return `${Math.floor(value / 60)} h ${value % 60} min`;
  }

  return `${value} min`;
};


