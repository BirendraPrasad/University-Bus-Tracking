   */

  renderAll();


  /*
   * Select active route.
   */

  pickActiveRoute();


  /*
   * Render bus details.
   */

  await renderBusDetails();


  /*
   * Live GPS polling is currently disabled.
   *
   * This prevents:
   *
   * /buses/undefined/location
   *
   * 404 spam.
   */

  startLivePolling();


  refreshMaps();
}


