function createMap(
  elementId,
  key
) {

  const element = $(elementId);

  if (
    !element ||
    typeof L === "undefined"
  ) {
    return;
  }

  /*
   * Use first real stop when available.
   * Otherwise use approximate university area.
   */
  const defaultStart = [
    13.219992,
    77.753943
  ];

  const map = L
    .map(element)
    .setView(
      defaultStart,
      15
    );

  L.tileLayer(
    "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
    {
      maxZoom: 19,
      attribution:
        "&copy; OpenStreetMap contributors"
    }
  ).addTo(map);

  state.maps[key] = map;
}


function initMaps() {

