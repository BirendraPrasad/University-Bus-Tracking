/* ==========================================================
   4. AUTH
   ========================================================== */

function readStorage(keys) {

  for (const store of [localStorage, sessionStorage]) {

    for (const key of keys) {

      const value = store.getItem(key);

      if (value) {
        return value;
      }
    }
  }

  return null;
}

function getToken() {

  return readStorage(CONFIG.TOKEN_KEYS);
}


function getStoredUser() {
  for (const store of [localStorage, sessionStorage]) {
    const token = store.getItem("access_token") ||
                  store.getItem("token") ||
                  store.getItem("accessToken") ||
                  store.getItem("jwt");

    if (!token) continue;

    const raw = CONFIG.USER_KEYS
      .map(key => store.getItem(key))
      .find(Boolean);

    let user = {};
    if (raw) {
      try {
        user = JSON.parse(raw) || {};
      } catch {
        user = { name: raw };
      }
    }

    return {
      ...user,
      id: user.id || store.getItem("user_id"),
      name: user.name || store.getItem("user_name"),
      email: user.email || store.getItem("user_email"),
      role: (
        user.role ||
        user.user_role ||
        store.getItem("user_role") ||
        ""
      ).toUpperCase()
    };
  }

  return null;
}


function requireAuth() {

  if (!getToken() && !getStoredUser()) {

    window.location.replace(CONFIG.LOGIN_PAGE);

    return false;
  }

  return true;
}


function logout() {

  [
    ...CONFIG.TOKEN_KEYS,
    ...CONFIG.USER_KEYS
  ].forEach((key) => {

    localStorage.removeItem(key);

  });

  window.location.replace(CONFIG.LOGIN_PAGE);
}


/* ==========================================================
   5. API LAYER
   ========================================================== */

async function apiFetch(path, options = {}) {

  const headers = {
    Accept: "application/json",
    ...(options.headers || {})
  };

  const token = getToken();

  if (token) {

    headers.Authorization = `Bearer ${token}`;
  }

  const response = await fetch(
    API_BASE_URL + path,
    {
      ...options,
      headers
    }
  );

  if (response.status === 401) {

    logout();

    throw new Error("Session expired");
  }

  if (!response.ok) {

    let message = `Request failed (${response.status})`;

    try {

      const errorData = await response.json();

      if (errorData?.detail) {
        message = errorData.detail;
      }

    } catch (error) {
      // Ignore JSON parsing errors.
    }

    throw new Error(message);
  }

  return response.json();
}


