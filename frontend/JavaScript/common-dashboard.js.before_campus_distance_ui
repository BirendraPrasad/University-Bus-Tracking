function updateBusLocation(
  latitude,
  longitude,
  isPlaceholder = false
) {

  if (
    typeof latitude !== "number" ||
    typeof longitude !== "number"
  ) {
    return;
  }

  Object.entries(
    state.maps
  ).forEach(
    ([key, map]) => {

      const label =
        isPlaceholder
          ? "Demo position"
          : "Bus location";


      if (!state.markers[key]) {

        state.markers[key] =
          L.marker([
            latitude,
            longitude
          ]).addTo(map);
      }


      state.markers[key]
        .setLatLng([
          latitude,
          longitude
        ])
        .bindPopup(label);


      map.panTo([
        latitude,
        longitude
      ]);

    }
  );


  setText(
    "mapUpdated",
    isPlaceholder
      ? "Demo position"
      : `Updated ${new Date().toLocaleTimeString()}`
  );


  setText(
    "trkMessage",
    isPlaceholder
      ? "Showing demo position"
      : "GPS location received"
  );


  const liveDot =
    $("liveDot");

  if (liveDot) {

    liveDot.classList.toggle(
      "on",
      !isPlaceholder
    );
  }


  const trackingMessage =
    $("trkMessage");

  if (trackingMessage) {

    trackingMessage.classList.toggle(
      "on",
      !isPlaceholder
    );
  }
}


